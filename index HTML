<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>PawStay — Your pet's home away from home</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --green:#1a6b4a;
  --green-light:#2d9467;
  --green-pale:#e8f5ee;
  --green-mid:#c5e8d4;
  --sand:#f7f4ef;
  --sand-dark:#ede8e0;
  --brown:#5c4a32;
  --text:#1c1c1c;
  --text-mid:#555;
  --text-soft:#888;
  --white:#fff;
  --radius:14px;
  --radius-lg:20px;
  --shadow:0 2px 20px rgba(26,107,74,.08);
  --shadow-lg:0 8px 40px rgba(26,107,74,.13);
}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--sand);color:var(--text);line-height:1.6;overflow-x:hidden}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(247,244,239,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--sand-dark);padding:0 5%;height:68px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.nav-logo-icon{width:36px;height:36px;background:var(--green);border-radius:10px;display:flex;align-items:center;justify-content:center}
.nav-logo-icon svg{width:20px;height:20px;fill:none;stroke:#fff;stroke-width:2}
.nav-logo-text{font-family:'Lora',serif;font-size:20px;font-weight:600;color:var(--green)}
.nav-links{display:flex;gap:32px;list-style:none}
.nav-links a{text-decoration:none;color:var(--text-mid);font-size:14px;font-weight:400;transition:color .2s}
.nav-links a:hover{color:var(--green)}
.nav-cta{background:var(--green);color:#fff;padding:9px 22px;border-radius:30px;font-size:14px;font-weight:500;text-decoration:none;transition:background .2s,transform .15s}
.nav-cta:hover{background:var(--green-light);transform:translateY(-1px)}
.nav-mobile-toggle{display:none;background:none;border:none;cursor:pointer;color:var(--text)}

/* HERO */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:120px 5% 80px;position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 70% 40%,var(--green-pale) 0%,var(--sand) 70%);z-index:0}
.hero-blob{position:absolute;top:-80px;right:-120px;width:600px;height:600px;background:var(--green-mid);border-radius:60% 40% 70% 30%/40% 60% 40% 60%;opacity:.35;z-index:0;animation:blobFloat 8s ease-in-out infinite}
@keyframes blobFloat{0%,100%{transform:scale(1) rotate(0deg)}50%{transform:scale(1.05) rotate(4deg)}}
.hero-content{position:relative;z-index:1;max-width:580px}
.hero-tag{display:inline-flex;align-items:center;gap:7px;background:var(--green-pale);border:1px solid var(--green-mid);color:var(--green);font-size:12px;font-weight:500;padding:5px 14px;border-radius:20px;margin-bottom:24px;animation:fadeUp .6s ease both}
.hero-tag-dot{width:7px;height:7px;background:var(--green);border-radius:50%;animation:pulse 2s ease infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}
.hero h1{font-family:'Lora',serif;font-size:clamp(38px,5vw,58px);font-weight:600;line-height:1.15;color:var(--text);margin-bottom:20px;animation:fadeUp .7s .1s ease both}
.hero h1 em{font-style:italic;color:var(--green)}
.hero p{font-size:17px;color:var(--text-mid);font-weight:300;max-width:440px;margin-bottom:36px;animation:fadeUp .7s .2s ease both}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap;animation:fadeUp .7s .3s ease both}
.btn-primary{background:var(--green);color:#fff;padding:14px 28px;border-radius:30px;font-size:15px;font-weight:500;text-decoration:none;border:none;cursor:pointer;transition:background .2s,transform .15s,box-shadow .2s}
.btn-primary:hover{background:var(--green-light);transform:translateY(-2px);box-shadow:0 6px 24px rgba(26,107,74,.25)}
.btn-outline{background:transparent;color:var(--green);padding:14px 28px;border-radius:30px;font-size:15px;font-weight:500;text-decoration:none;border:1.5px solid var(--green);cursor:pointer;transition:all .2s}
.btn-outline:hover{background:var(--green-pale);transform:translateY(-2px)}
.hero-stats{display:flex;gap:32px;margin-top:52px;animation:fadeUp .7s .4s ease both}
.hero-stat-num{font-family:'Lora',serif;font-size:26px;font-weight:600;color:var(--green)}
.hero-stat-label{font-size:12px;color:var(--text-soft);margin-top:2px}
.hero-image-float{position:absolute;right:5%;top:50%;transform:translateY(-50%);z-index:1;width:420px;animation:fadeUp .9s .2s ease both}
.hero-card-float{background:#fff;border-radius:var(--radius-lg);padding:20px;box-shadow:var(--shadow-lg);max-width:340px;margin-left:auto}
.hcf-top{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.hcf-avatar{width:50px;height:50px;border-radius:50%;background:var(--green-mid);display:flex;align-items:center;justify-content:center;font-size:22px}
.hcf-name{font-weight:500;font-size:15px}
.hcf-loc{font-size:12px;color:var(--text-soft);margin-top:1px}
.hcf-stars{display:flex;gap:2px;margin-bottom:12px}
.hcf-stars span{color:#f59e0b;font-size:16px}
.hcf-quote{font-size:13px;color:var(--text-mid);font-style:italic;font-family:'Lora',serif;line-height:1.6;border-left:3px solid var(--green-mid);padding-left:12px}
.hcf-tags{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap}
.hcf-tag{font-size:11px;background:var(--green-pale);color:var(--green);padding:3px 10px;border-radius:10px}
.hcf-badge{background:var(--green);color:#fff;border-radius:10px;padding:10px 14px;margin-top:14px;display:flex;align-items:center;gap:10px}
.hcf-badge-text{font-size:13px;font-weight:500}
.hcf-badge-sub{font-size:11px;opacity:.8}

@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}

/* TRUST BAR */
.trust-bar{background:var(--green);padding:14px 5%;display:flex;justify-content:center;gap:48px;flex-wrap:wrap}
.trust-item{display:flex;align-items:center;gap:8px;color:#fff;font-size:13px;font-weight:400}
.trust-item svg{width:18px;height:18px;stroke:#a8d8c0;fill:none;stroke-width:2;flex-shrink:0}

/* SECTION */
section{padding:80px 5%}
.section-tag{font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--green);margin-bottom:12px}
.section-title{font-family:'Lora',serif;font-size:clamp(28px,3.5vw,40px);font-weight:600;line-height:1.2;color:var(--text);margin-bottom:16px}
.section-subtitle{font-size:16px;color:var(--text-mid);font-weight:300;max-width:520px}

/* HOW IT WORKS */
.how-it-works{background:var(--white)}
.hiw-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px;margin-top:52px}
.hiw-step{position:relative}
.hiw-num{font-family:'Lora',serif;font-size:56px;font-weight:600;color:var(--green-mid);line-height:1;margin-bottom:8px}
.hiw-icon{width:52px;height:52px;background:var(--green-pale);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.hiw-icon svg{width:24px;height:24px;stroke:var(--green);fill:none;stroke-width:1.8}
.hiw-step h3{font-family:'Lora',serif;font-size:18px;font-weight:600;margin-bottom:8px}
.hiw-step p{font-size:14px;color:var(--text-mid);line-height:1.7}
.hiw-connector{position:absolute;top:80px;right:-16px;width:32px;height:2px;background:var(--green-mid);z-index:0}

/* SERVICES */
.services{background:var(--sand)}
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:52px}
.service-card{background:var(--white);border-radius:var(--radius-lg);padding:28px;border:1px solid transparent;transition:all .3s;cursor:pointer;position:relative;overflow:hidden}
.service-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--green-pale),transparent);opacity:0;transition:opacity .3s}
.service-card:hover{border-color:var(--green-mid);transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.service-card:hover::before{opacity:1}
.service-icon{width:56px;height:56px;background:var(--green-pale);border-radius:16px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;position:relative;z-index:1}
.service-icon svg{width:26px;height:26px;stroke:var(--green);fill:none;stroke-width:1.8}
.service-card h3{font-family:'Lora',serif;font-size:18px;font-weight:600;margin-bottom:8px;position:relative;z-index:1}
.service-card p{font-size:14px;color:var(--text-mid);line-height:1.7;margin-bottom:16px;position:relative;z-index:1}
.service-price{font-size:22px;font-weight:500;color:var(--green);position:relative;z-index:1}
.service-price span{font-size:13px;color:var(--text-soft);font-weight:400}
.service-features{margin-top:14px;position:relative;z-index:1}
.service-feature{font-size:13px;color:var(--text-mid);padding:4px 0;display:flex;align-items:center;gap:7px}
.service-feature::before{content:'✓';color:var(--green);font-weight:600;font-size:12px}

/* BOOKING SECTION */
.booking-section{background:var(--white)}
.booking-wrapper{max-width:640px;margin:52px auto 0;background:var(--sand);border-radius:var(--radius-lg);padding:36px;border:1px solid var(--sand-dark)}
.booking-steps{display:flex;gap:0;margin-bottom:32px;position:relative}
.booking-steps::after{content:'';position:absolute;top:18px;left:9%;right:9%;height:2px;background:var(--sand-dark);z-index:0}
.bstep{flex:1;text-align:center;position:relative;z-index:1}
.bstep-circle{width:36px;height:36px;border-radius:50%;background:var(--sand-dark);color:var(--text-soft);font-size:14px;font-weight:500;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;transition:all .3s}
.bstep.active .bstep-circle{background:var(--green);color:#fff}
.bstep.done .bstep-circle{background:var(--green-mid);color:var(--green)}
.bstep-label{font-size:12px;color:var(--text-soft);transition:color .3s}
.bstep.active .bstep-label{color:var(--green);font-weight:500}

.booking-form{display:none}
.booking-form.active{display:block}
.form-group{margin-bottom:20px}
.form-label{font-size:13px;font-weight:500;color:var(--text);margin-bottom:8px;display:block}
.form-input,.form-select,.form-textarea{width:100%;padding:12px 16px;border:1.5px solid var(--sand-dark);border-radius:var(--radius);background:var(--white);font-family:'DM Sans',sans-serif;font-size:14px;color:var(--text);outline:none;transition:border-color .2s}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--green)}
.form-textarea{resize:vertical;min-height:100px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.pet-types{display:flex;gap:10px;flex-wrap:wrap}
.pet-type-btn{padding:9px 18px;border:1.5px solid var(--sand-dark);border-radius:30px;background:var(--white);font-size:13px;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:6px}
.pet-type-btn.selected{border-color:var(--green);background:var(--green-pale);color:var(--green);font-weight:500}
.booking-nav{display:flex;justify-content:space-between;margin-top:28px;align-items:center}
.btn-back{background:none;border:1.5px solid var(--sand-dark);color:var(--text-mid);padding:11px 22px;border-radius:30px;font-size:14px;cursor:pointer;transition:all .2s}
.btn-back:hover{border-color:var(--green);color:var(--green)}
.booking-note{font-size:12px;color:var(--text-soft);text-align:center;margin-top:16px}

/* SITTERS */
.sitters{background:var(--sand)}
.sitters-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px;margin-top:52px}
.sitter-card{background:var(--white);border-radius:var(--radius-lg);overflow:hidden;border:1px solid transparent;transition:all .3s}
.sitter-card:hover{border-color:var(--green-mid);transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.sitter-photo{height:180px;background:var(--green-pale);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.sitter-avatar{width:90px;height:90px;border-radius:50%;background:var(--green-mid);display:flex;align-items:center;justify-content:center;font-family:'Lora',serif;font-size:28px;font-weight:600;color:var(--green)}
.sitter-badge{position:absolute;top:12px;right:12px;background:var(--green);color:#fff;font-size:11px;padding:4px 10px;border-radius:10px}
.sitter-info{padding:20px}
.sitter-name{font-family:'Lora',serif;font-size:17px;font-weight:600;margin-bottom:2px}
.sitter-loc{font-size:12px;color:var(--text-soft);margin-bottom:10px;display:flex;align-items:center;gap:4px}
.sitter-loc svg{width:12px;height:12px;stroke:var(--text-soft);fill:none;stroke-width:2}
.sitter-rating{display:flex;align-items:center;gap:6px;margin-bottom:12px}
.stars{color:#f59e0b;font-size:14px;letter-spacing:1px}
.rating-num{font-size:13px;font-weight:500}
.rating-count{font-size:12px;color:var(--text-soft)}
.sitter-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.sitter-tag{font-size:11px;background:var(--green-pale);color:var(--green);padding:3px 9px;border-radius:8px}
.sitter-footer{display:flex;align-items:center;justify-content:space-between;padding-top:14px;border-top:1px solid var(--sand-dark)}
.sitter-price{font-size:16px;font-weight:500;color:var(--green)}
.sitter-price span{font-size:12px;color:var(--text-soft);font-weight:400}
.btn-sm{background:var(--green);color:#fff;padding:8px 18px;border-radius:20px;font-size:13px;font-weight:500;border:none;cursor:pointer;text-decoration:none;transition:all .2s}
.btn-sm:hover{background:var(--green-light);transform:translateY(-1px)}

/* TESTIMONIALS */
.testimonials{background:var(--green);padding:80px 5%}
.testimonials .section-tag{color:var(--green-mid)}
.testimonials .section-title{color:#fff}
.testimonials .section-subtitle{color:rgba(255,255,255,.7)}
.testimonials-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:52px}
.testimonial-card{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);border-radius:var(--radius-lg);padding:28px;transition:all .3s}
.testimonial-card:hover{background:rgba(255,255,255,.15);transform:translateY(-3px)}
.t-stars{color:#fbbf24;font-size:15px;margin-bottom:16px}
.t-quote{font-family:'Lora',serif;font-size:15px;font-style:italic;color:#fff;line-height:1.7;margin-bottom:20px}
.t-author{display:flex;align-items:center;gap:12px}
.t-avatar{width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-family:'Lora',serif;font-size:16px;font-weight:600;color:#fff}
.t-name{font-weight:500;font-size:14px;color:#fff}
.t-loc{font-size:12px;color:rgba(255,255,255,.6);margin-top:1px}

/* FAQ */
.faq{background:var(--white)}
.faq-list{max-width:680px;margin:52px auto 0}
.faq-item{border-bottom:1px solid var(--sand-dark)}
.faq-q{width:100%;background:none;border:none;text-align:left;padding:20px 0;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:500;color:var(--text);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-q svg{width:20px;height:20px;stroke:var(--green);fill:none;stroke-width:2;flex-shrink:0;transition:transform .3s}
.faq-item.open .faq-q svg{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease,padding .3s}
.faq-item.open .faq-a{max-height:300px;padding-bottom:20px}
.faq-a p{font-size:14px;color:var(--text-mid);line-height:1.75}

/* BECOME A SITTER */
.become-sitter{background:var(--sand)}
.bs-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;margin-top:52px}
.bs-feature{display:flex;gap:16px;margin-bottom:28px}
.bs-icon{width:44px;height:44px;background:var(--green-pale);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.bs-icon svg{width:22px;height:22px;stroke:var(--green);fill:none;stroke-width:1.8}
.bs-text h4{font-size:15px;font-weight:500;margin-bottom:4px}
.bs-text p{font-size:13px;color:var(--text-mid);line-height:1.6}
.bs-form-card{background:var(--white);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow)}

/* FOOTER */
footer{background:#0e3a27;color:rgba(255,255,255,.7);padding:56px 5% 32px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px}
.footer-brand .nav-logo-text{color:#a8d8c0;display:block;margin-bottom:12px}
.footer-brand p{font-size:13px;line-height:1.7;max-width:260px}
.footer-col h4{font-size:13px;font-weight:500;color:#fff;margin-bottom:16px}
.footer-col ul{list-style:none}
.footer-col li{margin-bottom:10px}
.footer-col a{font-size:13px;color:rgba(255,255,255,.6);text-decoration:none;transition:color .2s}
.footer-col a:hover{color:#a8d8c0}
.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:gap}
.footer-bottom p{font-size:12px}
.footer-langs{display:flex;gap:12px}
.footer-lang{font-size:12px;color:rgba(255,255,255,.5);cursor:pointer;transition:color .2s}
.footer-lang:hover,.footer-lang.active{color:#a8d8c0}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s;padding:20px}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--white);border-radius:var(--radius-lg);padding:36px;max-width:480px;width:100%;position:relative;transform:translateY(20px);transition:transform .3s;max-height:90vh;overflow-y:auto}
.modal-overlay.open .modal{transform:translateY(0)}
.modal-close{position:absolute;top:16px;right:16px;background:var(--sand);border:none;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:18px;color:var(--text-mid);display:flex;align-items:center;justify-content:center;transition:background .2s}
.modal-close:hover{background:var(--sand-dark)}
.modal h2{font-family:'Lora',serif;font-size:22px;font-weight:600;margin-bottom:6px}
.modal .modal-sub{font-size:14px;color:var(--text-mid);margin-bottom:24px}
.success-msg{text-align:center;padding:20px 0}
.success-icon{width:64px;height:64px;background:var(--green-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:28px}
.success-msg h3{font-family:'Lora',serif;font-size:20px;margin-bottom:8px}
.success-msg p{font-size:14px;color:var(--text-mid)}

/* SCROLL ANIMATIONS */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

/* MOBILE NAV */
@media(max-width:768px){
  .nav-links,.nav-cta{display:none}
  .nav-mobile-toggle{display:block}
  .hero-image-float{display:none}
  .hero-stats{gap:24px}
  .bs-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr 1fr}
  .form-row{grid-template-columns:1fr}
  .hiw-connector{display:none}
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#" class="nav-logo">
    <div class="nav-logo-icon">
      <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M8 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M16 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M5 14a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M19 14a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M12 20c2.5 0 5-2 6-5H6c1 3 3.5 5 6 5z"/></svg>
    </div>
    <span class="nav-logo-text">PawStay</span>
  </a>
  <ul class="nav-links">
    <li><a href="#how-it-works">How it works</a></li>
    <li><a href="#services">Services</a></li>
    <li><a href="#sitters">Our sitters</a></li>
    <li><a href="#become-sitter">Become a sitter</a></li>
  </ul>
  <a href="#book" class="nav-cta">Book now</a>
  <button class="nav-mobile-toggle" onclick="toggleMobileMenu()" aria-label="Menu">☰</button>
</nav>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-bg"></div>
